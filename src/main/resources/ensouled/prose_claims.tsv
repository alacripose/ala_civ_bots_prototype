WHEN	para 580	if (1.5f * tx_coef - tx_bias > t_min) idx ˆ= 1, pos.x = 1.5f; if (1.5f * ty_coef - ty_bias > t_min) idx ˆ= 2, pos.y = 1.5f; if (1.5f * tz_coef - tz_bias > t_min) idx ˆ= 4, pos.z = 1.5f;
RECORD	para 581	// Traverse voxels along the ray as long as the current voxel // stays within the octree.
DEFINE	para 582	while (scale < s_max) { // Fetch child descriptor unless it is already valid.
WHEN	para 583	if (child_descriptor.x == 0) child_descriptor = *(int2*)parent;
RECORD	para 584	// Determine maximum t-value of the cube by evaluating // tx(), ty(), and tz() at its corner.
RECORD	para 585	float tx_corner = pos.x * tx_coef - tx_bias; float ty_corner = pos.y * ty_coef - ty_bias; float tz_corner = pos.z * tz_coef - tz_bias; float tc_max = fminf(fminf(tx_corner, ty_corner), tz_corner);
DEFINE	para 587	// Process voxel if the corresponding bit in valid mask is set // and the active t-span is non-empty.
WHEN	para 588	int child_shift = idx ˆ octant_mask; // permute child slots based on the mirroring int child_masks = child_descriptor.x << child_shift; if ((child_masks & 0x8000) != 0 && t_min <= t_max) { // Terminate if the voxel is small enough.
WHEN	para 589	if (tc_max * ray_size_coef + ray_size_bias >= scale_exp2) break; // at t_min
RECORD	para 590	// INTERSECT // Intersect active t-span with the cube and evaluate // tx(), ty(), and tz() at the center of the voxel.
RECORD	para 591	float tv_max = fminf(t_max, tc_max); float half = scale_exp2 * 0.5f; float tx_center = half * tx_coef + tx_corner; float ty_center = half * ty_coef + ty_corner; float tz_center = half * tz_coef + tz_corner;
DEFINE	para 592	// Intersect with contour if the corresponding bit in contour mask is set.
RECORD	para 594	t_min = fmaxf(t_min, tcoef * tavg - fabsf(tdiff)); // Override t_min with tv_min. tv_max = fminf(tv_max, tcoef * tavg + fabsf(tdiff)); }
DEFINE	para 595	// Descend to the first child if the resulting t-span is non-empty.
DEFINE	para 596	if (t_min <= tv_max) { // Terminate if the corresponding bit in the non-leaf mask is not set.
WHEN	para 597	if ((child_masks & 0x0080) == 0) break; // at t_min (overridden with tv_min).
RECORD	para 598	// PUSH // Write current parent to the stack.
WHEN	para 599	if (tc_max < h) stack[scale] = make_int2((int)parent, __float_as_int(t_max)); h = tc_max;
RECORD	para 600	// Find child descriptor corresponding to the current voxel.
WHEN	para 601	int ofs = (unsigned int)child_descriptor.x >> 17; // child pointer if ((child_descriptor.x & 0x10000) != 0) // far ofs = parent[ofs * 2]; // far pointer ofs += popc8(child_masks & 0x7F); parent += ofs * 2;
RECORD	para 602	// Select child voxel that the ray enters first.
RECORD	para 603	idx = 0; scale--; scale_exp2 = half;
WHEN	para 604	if (tx_center > t_min) idx ˆ= 1, pos.x += scale_exp2; if (ty_center > t_min) idx ˆ= 2, pos.y += scale_exp2; if (tz_center > t_min) idx ˆ= 4, pos.z += scale_exp2;
RECORD	para 605	// Update active t-span and invalidate cached child descriptor.
RECORD	para 606	t_max = tv_max; child_descriptor.x = 0; continue; } } 29
RECORD	para 607	// ADVANCE // Step along the ray.
WHEN	para 608	int step_mask = 0; if (tx_corner <= tc_max) step_mask ˆ= 1, pos.x -= scale_exp2; if (ty_corner <= tc_max) step_mask ˆ= 2, pos.y -= scale_exp2; if (tz_corner <= tc_max) step_mask ˆ= 4, pos.z -= scale_exp2;
RECORD	para 609	// Update active t-span and flip bits of the child slot index.
RECORD	para 610	t_min = tc_max; idx ˆ= step_mask;
WHEN	para 611	// Proceed with pop if the bit flips disagree with the ray direction.
WHEN	para 612	if ((idx & step_mask) != 0) { // POP // Find the highest differing bit between the two positions.
RECORD	para 614	// Restore parent voxel from the stack.
RECORD	para 615	int2 stackEntry = stack[scale]; parent = (int*)stackEntry.x; t_max = __int_as_float(stackEntry.y);
RECORD	para 616	// Round cube position and extract child slot index.
RECORD	para 617	int shx = __float_as_int(pos.x) >> scale; int shy = __float_as_int(pos.y) >> scale; int shz = __float_as_int(pos.z) >> scale; pos.x = __int_as_float(shx << scale); pos.y = __int_as_float(shy << scale); pos.z = __int_as_float(shz << scale); idx = (shx & 1) | ((shy & 1) << 1) | ((shz & 1) << 2);
RECORD	para 618	// Prevent same parent from being stored again and invalidate cached child descriptor.
RECORD	para 619	h = 0.0f; child_descriptor.x = 0; } }
DEFINE	para 620	// Indicate miss if we are outside the octree.
WHEN	para 621	if (scale >= s_max) t_min = 2.0f;
RECORD	para 622	// Undo mirroring of the coordinate system.
WHEN	para 623	if ((octant_mask & 1) == 0) pos.x = 3.0f - scale_exp2 - pos.x; if ((octant_mask & 2) == 0) pos.y = 3.0f - scale_exp2 - pos.y; if ((octant_mask & 4) == 0) pos.z = 3.0f - scale_exp2 - pos.z;
RECORD	Phase Change, Ice, and Its Light Spectrum Page 1	Phase Change, Ice, and Its Light Spectrum Page 1
RECORD	para 2	PHYSICS OF WATER Phase Change, Ice, and Its Light Spectrum
RECORD	A real-world guide to freezing and melting, ice crystal structure, and why ice i	A real-world guide to freezing and melting, ice crystal structure, and why ice interacts with different colors and wavelengths of light in very different ways.
WHEN	para 4	Core idea What changes when water becomes ice?
DEFINE	para 5	Phase Molecules become organized into a solid crystal or other solid ice form, while energy is exchanged as latent heat.
DEFINE	para 6	Light The solid is not simply "transparent" or "opaque". Ice has wavelength-dependent reflection, refraction, scattering, and absorption.
RECORD	para 7	Why blue? Pure ice absorbs visible red light more strongly than blue light. Long optical paths can therefore leave transmitted/reflected light relatively bluer.
RECORD	para 8	Scope. This document focuses on ordinary water ice, especially hexagonal ice Ih near Earth conditions. The optical spectrum is presented conceptually; for numerical optical constants, use the referenced Warren & Brandt tables.
RECORD	Phase Change, Ice, and Its Light Spectrum Page 2	Phase Change, Ice, and Its Light Spectrum Page 2
RECORD	para 10	1. What a phase change actually is
RECORD	para 11	A phase change is a change in the collective physical state of matter. For water near everyday pressures, the familiar phases are solid ice, liquid water, and water vapor. The molecules are still H2O in every case; what changes is their organization, motion, and thermodynamic state.
DEFINE	Melting and freezing are energy-transfer problems	Melting and freezing are energy-transfer problems
WHEN	para 13	When ice melts at its melting temperature, added energy does not immediately show up as a temperature increase. Instead, energy is used to change the molecular arrangement from the solid to the liquid. The amount is the latent heat of fusion. The reverse process - freezing - releases approximately the same latent heat.
RECORD	para 14	For a mass m undergoing a phase change at equilibrium:
RECORD	Q = m Lf	Q = m Lf
DEFINE	para 16	For water near 0 C, Lf is about 333.5 kJ/kg. That means freezing 1 kg of water releases about 333.5 kJ of latent heat, while melting 1 kg of ice requires about the same amount under comparable conditions.
RECORD	Why temperature can stay near 0 C while ice melts	Why temperature can stay near 0 C while ice melts
RECORD	Phase Change, Ice, and Its Light Spectrum Page 3	Phase Change, Ice, and Its Light Spectrum Page 3
RECORD	para 20	2. Why water makes an unusual ice
RECORD	para 21	Ordinary terrestrial ice at modest pressure is mainly hexagonal ice Ih. Its crystal arrangement is controlled by hydrogen bonding: each H2O molecule tends to form a directional network that produces an open lattice. This makes ice Ih less dense than liquid water, which is why ordinary ice floats.
RECORD	The melting curve slopes the "wrong" way	The melting curve slopes the "wrong" way
RECORD	para 23	For most substances, increasing pressure raises the melting temperature. Water is unusual because the solid is less dense than the liquid. Along the ice-water equilibrium line, increasing pressure slightly lowers the melting temperature. Thermodynamically this follows from the Clapeyron relation:
RECORD	para 24	dP/dT = ∆S / ∆V
RECORD	para 25	For melting, ∆S is positive. For ordinary ice Ih melting to liquid water, ∆V = Vliquid - Vice is negative, so the slope dP/dT is negative. The effect is real but small at ordinary pressures; dramatic claims about everyday pressure "melting ice" are often overstated.
DEFINE	para 26	The phase diagram of water contains many additional high-pressure ice phases that are not relevant to ordinary snow, glaciers, or household ice. The diagram above is intentionally schematic and exaggerated.
RECORD	Phase Change, Ice, and Its Light Spectrum Page 4	Phase Change, Ice, and Its Light Spectrum Page 4
RECORD	para 28	3. How liquid water becomes ice: nucleation
WHEN	para 29	Cooling below 0 C does not guarantee instantaneous freezing. Liquid water can persist in a supercooled state when there is no sufficiently favorable site for an ice nucleus to form. Freezing begins when a stable ice embryo appears and grows.
RECORD	para 30	Homogeneous vs. heterogeneous nucleation
RECORD	para 31	• Homogeneous nucleation: an ice embryo forms within the water itself. It generally requires very strong supercooling for tiny pure droplets.
RECORD	para 32	• Heterogeneous nucleation: a surface or particle - such as mineral dust, biological material, a container wall, or another ice particle - helps initiate the ice structure. This is much more common in natural environments.
RECORD	para 33	The exact freezing temperature of a droplet depends on droplet size, composition, cooling history, impurities, and the microscopic properties of the nucleating interface. There is therefore no single temperature at which every bit of water in nature suddenly freezes. Atmospheric ice-nucleation research treats freezing as a probabilistic process rather than a perfect switch.
RECORD	What happens at the moving ice-water boundary	What happens at the moving ice-water boundary
RECORD	para 35	Once a stable crystal nucleus forms, water molecules near the interface become incorporated into the growing solid lattice. The interface releases latent heat, so the local temperature and heat transport matter. Crystal shape also depends on temperature, supersaturation, impurities, and growth direction. This is why snow crystals can develop plates, needles, columns, dendrites, and many intermediate forms.
RECORD	para 36	Useful deeper reading: Koop (2004) reviews homogeneous ice nucleation in water and aqueous solutions, while Ickes et al. (2015) examines the thermodynamic and kinetic parameters used in classical nucleation theory.
RECORD	Phase Change, Ice, and Its Light Spectrum Page 5	Phase Change, Ice, and Its Light Spectrum Page 5
DEFINE	para 38	4. Ice is not one single structure
RECORD	para 39	The word "ice" covers a family of solid H2O phases. Ordinary surface ice on Earth is overwhelmingly ice Ih, but different pressure and temperature conditions can produce other crystalline or amorphous forms. For atmospheric and terrestrial optics, the distinction matters because crystal structure and temperature affect the optical constants.
RECORD	Ice form Where it matters Optical relevance	Ice form Where it matters Optical relevance
RECORD	Ice Ih Ordinary snow, glaciers, sea ice, household	Ice Ih Ordinary snow, glaciers, sea ice, household ice Primary reference for Earth optical-property calculations
RECORD	Ice Ic / cubic ice Can occur in very cold or special nucleation	Ice Ic / cubic ice Can occur in very cold or special nucleation conditions Optical constants can differ from Ih, especially at some wavelengths
RECORD	Amorphous ice Very low temperatures, laboratory/space	Amorphous ice Very low temperatures, laboratory/space environments Structure and spectra differ from crystalline ice
RECORD	High-pressure	High-pressure ices Deep planetary interiors and laboratory high-pressure experiments Relevant to planetary science rather than everyday Earth ice
RECORD	Why structure matters for light	Why structure matters for light
RECORD	para 46	Light interacts with the electric polarization of molecules and the geometry of the material. In a crystal, molecular vibrations and electronic transitions occur at characteristic frequencies. The optical response is summarized by a complex refractive index: m(λ) = n(λ) + i k(λ)
RECORD	para 47	The real part n controls refraction and phase velocity; the imaginary part k is tied to absorption. For ice, wavelength-dependent measurements of n and k are the basis for predicting transmission, reflection, scattering, and absorption.
RECORD	Phase Change, Ice, and Its Light Spectrum Page 6	Phase Change, Ice, and Its Light Spectrum Page 6
RECORD	para 49	5. Where "light" sits in the spectrum
RECORD	para 50	Light is electromagnetic radiation. The same physics applies from radio waves through microwaves, infrared, visible light, ultraviolet, X-rays, and beyond, but the interaction with ice changes because the wavelength changes relative to molecular and structural length scales.
RECORD	Gamma / X-ray UV VISIBLE IR Microwave Radio	Gamma / X-ray UV VISIBLE IR Microwave Radio
RECORD	para 52	400-700 nm = visible light 1 um = 1000 nm 10 um = 10,000 nm
RECORD	Different wavelength, different interaction	Different wavelength, different interaction
RECORD	para 54	• Ultraviolet: stronger electronic absorption appears as wavelength becomes sufficiently short.
DEFINE	para 55	• Visible (roughly 0.4-0.7 um): pure ice is a very weak absorber; clean, bubble-free ice can transmit visible light over long distances.
RECORD	para 56	• Near-infrared (about 0.7-2.5 um): water-molecule vibrational overtones and combinations create pronounced absorption bands.
RECORD	para 57	• Mid/far infrared: molecular rotations/librations and lattice motions produce strong absorption features; ice becomes much more thermally emissive/absorptive.
DEFINE	para 58	• Microwave/radio: penetration can again become comparatively large, which is why radar can see through substantial ice and snow.
DEFINE	para 59	The exact boundaries between spectral bands vary by convention; the physics is continuous even though we use labels such as visible, near-IR, and thermal IR.
RECORD	Phase Change, Ice, and Its Light Spectrum Page 7	Phase Change, Ice, and Its Light Spectrum Page 7
RECORD	para 61	6. The visible spectrum of ice: why ice can look blue
RECORD	para 62	The visible portion of sunlight spans roughly 400-700 nm. Pure ice is unusually transparent over much of this range, but it is not perfectly non-absorbing. Its absorption coefficient increases toward the red end of the visible spectrum.
RECORD	Selective absorption gives long-path ice a blue bias	Selective absorption gives long-path ice a blue bias
DEFINE	para 64	A useful way to think about transmission through a uniform absorbing material is the Beer-Lambert relation:
RECORD	I(x,λ) = I0(λ) exp[-α(λ)x]	I(x,λ) = I0(λ) exp[-α(λ)x]
ALLOW	para 67	So a short, clean piece of ice may look essentially colorless. A glacier, thick iceberg, deep crevasse, or very long internal optical path can selectively suppress more red light, making the surviving light relatively bluer. The effect is not that ice "contains blue dye"; it follows from the wavelength dependence of absorption combined with the geometry of light paths.
DEFINE	Why snow is white instead of blue	Why snow is white instead of blue
RECORD	Phase Change, Ice, and Its Light Spectrum Page 8	Phase Change, Ice, and Its Light Spectrum Page 8
DEFINE	para 71	7. The infrared spectrum is where ice becomes much more selective
RECORD	In the infrared, the H	In the infrared, the H 2O molecule has vibrational and rotational degrees of freedom that couple strongly to electromagnetic radiation. Ice therefore develops strong absorption bands that are much more pronounced than its visible absorption.
RECORD	Important near-IR and thermal-IR regions	Important near-IR and thermal-IR regions
RECORD	para 74	Near-IR: features around roughly 1.5 and 2.0 um are especially useful for distinguishing snow/ice from many other surfaces in remote sensing. Stronger absorption around ~3 um is associated with water's fundamental vibrational absorption and is particularly strong.
RECORD	para 75	Thermal IR: ice has strong molecular absorption/emission features in the several-to-tens-of-micrometre range. This matters because Earth emits thermal radiation primarily in the infrared. Natural snow is therefore highly emissive in much of the thermal IR; Warren (2019) reports snow emissivity around 98-99%.
DEFINE	Absorption is not the same as reflection	Absorption is not the same as reflection
RECORD	Phase Change, Ice, and Its Light Spectrum Page 9	Phase Change, Ice, and Its Light Spectrum Page 9
DEFINE	para 79	8. Real ice is not ideal ice
DEFINE	para 80	Laboratory optical constants for nearly pure ice are a baseline, not a guarantee of what a glacier, pond, snowpack, or freezer cube will look like. Bulk appearance depends strongly on structure and impurities.
RECORD	Factor What it does to light Visible result	Factor What it does to light Visible result
RECORD	Air bubbles Add many ice-air interfaces and scatter light Cloudier, whiter, less	Air bubbles Add many ice-air interfaces and scatter light Cloudier, whiter, less transparent ice
RECORD	Cracks / grain	Cracks / grain boundaries Create additional reflection and refraction paths Brighter, hazier, more complex appearance
RECORD	Larger optical path Increases cumulative wavelength-dependent	Larger optical path Increases cumulative wavelength-dependent absorption Can strengthen blue appearance in clean ice
RECORD	Dust / soot /	Dust / soot / biological material Adds broad or selective light absorption Darker snow/ice and reduced albedo
RECORD	Brine / dissolved	Brine / dissolved material Changes refractive index and absorption; may create micro-inclusions Different optical texture, especially in sea ice
RECORD	para 87	Grain size Changes scattering path length and surface area Strong effect on snow reflectance, especially in near-IR
RECORD	A practical mental model	A practical mental model
RECORD	para 89	Think of a photon entering real ice as taking a path through a maze. At every interface it can change direction, reflect, or transmit; along every piece of its path inside the ice, it has a wavelength-dependent probability of being absorbed. The final color is determined by the distribution of path lengths plus the material's optical constants.
RECORD	Phase Change, Ice, and Its Light Spectrum Page 10	Phase Change, Ice, and Its Light Spectrum Page 10
RECORD	para 91	9. Putting phase change and optics together
RECORD	para 93	Example: a freezer ice cube
RECORD	para 94	• As water cools, dissolved gases become less soluble and can form bubbles.
RECORD	para 95	• Freezing begins at nucleation sites and a solidification front moves through the water.
ALLOW	para 96	• Impurities and gases may be pushed into the remaining liquid and become concentrated or trapped as the front moves.
RECORD	para 97	• The final cube can therefore contain bubbles, cracks, trapped solute, and different crystal textures.
RECORD	para 98	• Those features scatter visible light strongly, making the cube look white or cloudy even though pure bubble-free ice is highly transparent.
RECORD	para 99	Example: glacier ice
RECORD	para 100	• Snow grains compact and recrystallize over time, reducing air space.
RECORD	para 101	• Pressure and annealing can eliminate some bubbles and alter grain structure.
RECORD	para 102	• Long optical paths through relatively clean ice can make red absorption accumulate, producing a blue appearance in deep ice.
RECORD	para 103	• Impurities, fractures, bubbles, and debris modify both scattering and absorption.
RECORD	para 104	Example: satellite remote sensing
RECORD	para 105	Sensors exploit wavelength-dependent reflection and absorption. Visible wavelengths can be sensitive to surface brightness and impurities; near-IR bands are especially useful for distinguishing snow and ice and for inferring grain-size-related properties; thermal IR probes emitted radiation; microwave and radar wavelengths can penetrate snow and ice to depths that visible light cannot.
RECORD	Phase Change, Ice, and Its Light Spectrum Page 11	Phase Change, Ice, and Its Light Spectrum Page 11
RECORD	para 107	10. Scientific references for deeper study
WHEN	para 108	The links below are chosen to lead directly to journal pages, DOI records, or freely available full text/data. The Warren & Brandt compilation is especially useful when you need numerical optical constants rather than a qualitative explanation.
RECORD	para 109	Warren, S. G. & Brandt, R. E. (2008). Optical constants of ice from the ultraviolet to the microwave: A revised compilation. Journal of Geophysical Research, 113, D14220. DOI: 10.1029/2007JD009744.
RECORD	Direct DOI / paper link	Direct DOI / paper link
RECORD	para 111	Warren, S. G. (2019). Optical properties of ice and snow. Philosophical Transactions of the Royal Society A, 377, 20180161. DOI: 10.1098/rsta.2018.0161. Excellent broad review of visible, infrared, snow, ice, remote sensing, and radiative transfer.
RECORD	para 113	Warren, S. G., Brandt, R. E. & Grenfell, T. C. (2006). Visible and near-ultraviolet absorption spectrum of ice from transmission of solar radiation into snow. Applied Optics, 45, 5320-5334. DOI: 10.1364/AO.45.005320.
RECORD	para 115	Grenfell, T. C. & Perovich, D. K. (1981). Radiation absorption coefficients of polycrystalline ice from 400 to 1400 nm. Journal of Geophysical Research, 86, 7447-7450. DOI: 10.1029/JC086iC08p07447.
RECORD	para 117	Schaaf, J. W. & Williams, D. (1973). Optical constants of ice in the infrared. Journal of the Optical Society of America, 63, 726-732. DOI: 10.1364/JOSA.63.000726.
RECORD	para 119	Curtis, D. B., Rajaram, B., Toon, O. B. & Tolbert, M. A. (2005). Measurement of the temperature-dependent optical constants of water ice in the 15-200 um range. Applied Optics, 44, 4102-4118. DOI: 10.1364/AO.44.004102.
RECORD	para 121	Ickes, L., Welti, A., Hoose, C. & Lohmann, U. (2015). Classical nucleation theory of homogeneous freezing of water: thermodynamic and kinetic parameters. Physical Chemistry Chemical Physics, 17, 5514-5537. DOI: 10.1039/C4CP04184D.
RECORD	para 123	Koop, T. (2004). Homogeneous Ice Nucleation in Water and Aqueous Solutions. Zeitschrift fuer Physikalische Chemie, 218, 1231-1258. DOI: 10.1524/zpch.218.11.1231.50812.
RECORD	para 125	Gardner, D. B. & Wang, H. (2024). Critical review of modeling, measurement, and prediction of ice nucleation on surfaces. International Journal of Refrigeration, 163, 32-44. DOI: 10.1016/j.ijrefrig.2024.04.005.
RECORD	para 127	Warren, S. G. (1984). Optical constants of ice from the ultraviolet to the microwave. Applied Optics, 23, 1206-1225. DOI: 10.1364/AO.23.001206. Foundational compilation superseded by the 2008 revision.
RECORD	Numerical optical-constant data	Numerical optical-constant data
RECORD	para 130	Warren & Brandt ice optical-constants data tables - numerical values of n and k over broad spectral ranges and temperatures.
RECORD	para 131	RefractiveIndex.INFO - Warren & Brandt 2008 dataset - convenient browser interface for the complex refractive index of H2O ice.
RECORD	para 132	Note on the spectrum figure: the plotted absorption curve is intentionally qualitative and is not presented as measurement data. Exact numerical values depend on wavelength, temperature, ice phase, sample quality, and measurement method. Use the cited optical-constant compilations for quantitative modeling.
